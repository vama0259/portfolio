---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Sheet from "../components/Sheet.astro";
import Figures from "../components/Figures.astro";
import Entry from "../components/Entry.astro";
import { profile } from "../data/profile";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <!-- Masthead + abstract + results table: the whole first viewport. -->
  <Sheet>
    <div class="home-masthead">
      <h1
        class="u-display home-title"
      >
        {profile.name}
      </h1>
      <p class="home-subtitle">
        Data scientist, generative AI and LLM engineering. {profile.roles[0].company}, Pune.
      </p>
    </div>

    <p class="lede">
      {profile.positioning}
    </p>

    <Figures metrics={profile.headline} prefix="home" />
  </Sheet>

  <hr class="rule full section-divider" />

  <!-- SS1 Selected work -->
  <Sheet>
    <h2
      class="u-label section-heading"
    >
      Selected work
    </h2>
    <div>
      {
        work.map((entry) => (
          <Entry
            slug={entry.id}
            title={entry.data.title}
            tagline={entry.data.tagline}
            status={entry.data.status}
            period={entry.data.period}
            stack={entry.data.stack}
          />
        ))
      }
    </div>
    <p class="section-footer-link">
      <a href="/work" class="link-underline">
        All work
      </a>
    </p>
  </Sheet>

  <hr class="rule full section-divider" />

  <!-- SS2 Publications -->
  <Sheet>
    <h2
      class="u-label section-heading"
    >
      Publications
    </h2>
    <div>
      {
        profile.publications.map((p) => (
          <div class="pub-row">
            <p class="fig pub-venue">
              {p.venue}
              {p.note.includes("First author") && (
                <span class="u-label pub-badge">
                  First author
                </span>
              )}
            </p>
            <h3 class="pub-title">
              {p.title}
            </h3>
            <p class="pub-note">
              {p.note.replace(/^First author\s*[·-]\s*/, "")}
            </p>
          </div>
        ))
      }
    </div>
  </Sheet>
</Base>
