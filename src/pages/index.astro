---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Sheet from "../components/Sheet.astro";
import Figures from "../components/Figures.astro";
import Entry from "../components/Entry.astro";
import { profile } from "../data/profile";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <!-- Masthead + abstract + results table: the whole first viewport. -->
  <Sheet>
    <div style="padding-top: var(--space-page);">
      <h1
        class="u-display"
        style="font-size: var(--text-display); line-height: var(--text-display--line-height); letter-spacing: -0.02em; color: var(--color-ink);"
      >
        {profile.name}
      </h1>
      <p style="margin-top: var(--space-tight); font-size: var(--text-lede); color: var(--color-ink-muted);">
        Data scientist, generative AI and LLM engineering. {profile.roles[0].company}, Pune.
      </p>
    </div>

    <p style="margin-top: var(--space-block); font-size: var(--text-lede); line-height: var(--text-lede--line-height); color: var(--color-ink);">
      {profile.positioning}
    </p>

    <Figures metrics={profile.headline} prefix="home" />
  </Sheet>

  <hr class="rule full" style="margin-top: var(--space-section); margin-inline: auto; max-width: var(--page-max);" />

  <!-- SS1 Selected work -->
  <Sheet>
    <h2
      class="u-label"
      style="margin-top: var(--space-section); font-size: var(--text-caption); color: var(--color-ink-muted);"
    >
      Selected work
    </h2>
    <div>
      {
        work.map((entry) => (
          <Entry
            slug={entry.id}
            title={entry.data.title}
            tagline={entry.data.tagline}
            status={entry.data.status}
            period={entry.data.period}
            stack={entry.data.stack}
          />
        ))
      }
    </div>
    <p style="padding-top: var(--space-block); border-top: 1px solid var(--color-hairline);">
      <a href="/work" style="font-size: var(--text-body); color: var(--color-ink); text-decoration: underline; text-decoration-color: var(--color-rule); text-underline-offset: 3px;">
        All work
      </a>
    </p>
  </Sheet>

  <hr class="rule full" style="margin-top: var(--space-section); margin-inline: auto; max-width: var(--page-max);" />

  <!-- SS2 Publications -->
  <Sheet>
    <h2
      class="u-label"
      style="margin-top: var(--space-section); font-size: var(--text-caption); color: var(--color-ink-muted);"
    >
      Publications
    </h2>
    <div>
      {
        profile.publications.map((p, i) => (
          <div style={`padding-block: var(--space-block); ${i > 0 ? "border-top: 1px solid var(--color-hairline);" : ""}`}>
            <p class="fig" style="font-size: var(--text-note); color: var(--color-ink-muted);">
              {p.venue}
              {p.note.includes("First author") && (
                <span class="u-label" style="margin-left: 0.75rem; font-size: var(--text-label); color: var(--color-ink);">
                  First author
                </span>
              )}
            </p>
            <h3 style="margin-top: 0.35rem; font-family: var(--font-text); font-weight: 600; font-size: var(--text-h2); color: var(--color-ink);">
              {p.title}
            </h3>
            <p style="margin-top: 0.35rem; font-size: var(--text-note); color: var(--color-ink-muted);">
              {p.note}
            </p>
          </div>
        ))
      }
    </div>
  </Sheet>
</Base>
