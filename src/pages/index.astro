---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Sheet from "../components/Sheet.astro";
import Figures from "../components/Figures.astro";
import Entry from "../components/Entry.astro";
import { profile } from "../data/profile";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);

const talkToData = work.find((w) => w.id === "talk-to-data");
const costMetric = talkToData?.data.metrics.find((m) => /cost/i.test(m.label));

// Hero panel — the mockup's "Live figures" strip. Headline numbers come
// straight from profile.ts; the fourth row (cost/query) is pulled from the
// Talk to Data case study rather than hardcoded, per the same rule.
const liveFigures = [...profile.headline, ...(costMetric ? [costMetric] : [])];

// Results, plotted — the three charts the mockup ships, sourced from the
// case studies that actually produced them rather than restated by hand.
const plottedLabels = ["Accuracy", "Consistency", "Component ID"];
const plotted = work
  .flatMap((w) => w.data.metrics)
  .filter((m) => plottedLabels.includes(m.label));
---

<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="hero-tag"><span class="sw"></span> {profile.title}</div>
        <h1 class="display hero-title">
          <span class="line"><span>Systems that go to <span class="accent">production</span></span></span>
          <span class="line"><span>and stay there.</span></span>
        </h1>
        <p class="hero-sub">{profile.positioning}</p>
        <div class="hero-role">
          {profile.roles[0].company} <span class="sep">/</span> {profile.location} <span class="sep">/</span>{" "}
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </div>
      </div>

      <div class="hero-panel">
        <div class="head">Live figures &mdash; basis logged</div>
        {
          liveFigures.map((f) => {
            const numMatch = f.value.match(/^(\d+(?:\.\d+)?)/);
            const num = numMatch && !/[–—]/.test(f.value) ? numMatch[1] : undefined;
            const suffix = num ? f.value.slice(num.length) : "";
            return (
              <div class="row">
                <span class="k">{f.label}</span>
                <span class="v mono" data-final={f.value} data-num={num} data-suffix={suffix}>
                  {f.value}
                </span>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <section id="metrics">
    <div class="wrap">
      <div class="kicker">
        <span class="idx">01</span>
        <h2>Results, plotted</h2>
        <span class="rule"></span>
        <span class="meta">n = 500-question benchmark unless noted</span>
      </div>
      <Figures metrics={plotted} prefix="home" />
    </div>
  </section>

  <section id="work">
    <div class="wrap">
      <div class="kicker">
        <span class="idx">02</span>
        <h2>Selected work</h2>
        <span class="rule"></span>
      </div>
      <div class="work-list">
        {
          work.map((entry, i) => (
            <Entry
              slug={entry.id}
              index={i + 1}
              title={entry.data.title}
              tagline={entry.data.tagline}
              status={entry.data.status}
              period={entry.data.period}
              stack={entry.data.stack}
              metrics={entry.data.metrics}
              revealIndex={i}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section id="publications">
    <div class="wrap">
      <div class="kicker">
        <span class="idx">03</span>
        <h2>Publications</h2>
        <span class="rule"></span>
      </div>
      {
        profile.publications.map((p) => (
          <div class="pub-row" data-fade="row">
            <div class="venue mono">{p.venue}</div>
            <div>
              <h3>{p.title}</h3>
              <p>{p.note}</p>
            </div>
            <div class="tag">{p.note.includes("peer-reviewed") ? "Peer-reviewed" : ""}</div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="about">
    <div class="wrap about-grid">
      <div class="about-copy" data-fade="panel">
        <div class="kicker">
          <span class="idx">04</span>
          <h2>About</h2>
          <span class="rule"></span>
        </div>
        <p>
          I'm <strong>{profile.name}</strong>, a {profile.title} at <strong>{profile.roles[0].company}</strong> in{" "}
          {profile.location}. My work sits across three layers of the same problem:{" "}
          <strong>agent architecture</strong> &mdash; deciding what an LLM system is allowed to do and when it
          should stop and ask; <strong>evaluation</strong> &mdash; building the benchmarks that prove a system
          works before a user finds out it doesn't; and <strong>guardrails</strong> &mdash; the read-only
          boundaries and human-in-the-loop gates that keep an autonomous system honest in production.
        </p>
        <p>
          On Talk to Data I own the agent architecture, LLMOps, security and frontend workstreams &mdash; I
          architect, build, and engineer the system end to end.
        </p>
        <div class="edu-panel">
          <div class="k">Education</div>
          <div class="v">{profile.education.degree}</div>
          <div class="g">
            {profile.education.school} &middot; {profile.education.gpa} GPA &middot; {profile.education.dates}
          </div>
        </div>
      </div>

      <div data-fade="panel" id="contact">
        <div class="contact-panel">
          <h3>Let's talk shop.</h3>
          <a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>
          <div class="loc">{profile.roles[0].company} &middot; {profile.location}</div>
        </div>
      </div>
    </div>
  </section>
</Base>
