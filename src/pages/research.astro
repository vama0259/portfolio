---
import Base from "../layouts/Base.astro";
import Sheet from "../components/Sheet.astro";
import { profile } from "../data/profile";
---

<Base title="Research - Varun Malhotra">
  <Sheet rail={false}>
    <h1
      class="u-display"
      style="margin-top: var(--space-page); font-size: var(--text-h2); color: var(--color-ink);"
    >
      Research
    </h1>
    <p style="margin-top: var(--space-tight); font-size: var(--text-lede); line-height: var(--text-lede--line-height); color: var(--color-ink-muted);">
      Two peer-reviewed papers, both grown out of production problems rather than the other way round.
    </p>

    <div style="margin-top: var(--space-section);">
      {
        profile.publications.map((p, i) => (
          <div style={`padding-block: var(--space-block); ${i > 0 ? "border-top: 1px solid var(--color-hairline);" : ""}`}>
            <p class="fig" style="font-size: var(--text-note); color: var(--color-ink-muted);">
              {p.venue}
              {p.note.includes("First author") && (
                <span class="u-label" style="margin-left: 0.75rem; font-size: var(--text-label); color: var(--color-ink);">
                  First author
                </span>
              )}
            </p>
            <h2 style="margin-top: 0.35rem; font-family: var(--font-text); font-weight: 600; font-size: var(--text-h3); color: var(--color-ink);">
              {p.title}
            </h2>
            <p style="margin-top: 0.2rem; font-size: var(--text-note); color: var(--color-ink-muted);">{p.note}</p>
            <p style="margin-top: var(--space-tight); max-width: var(--measure); font-size: var(--text-body); line-height: var(--text-body--line-height); color: var(--color-ink);">
              {p.detail}
            </p>
          </div>
        ))
      }
    </div>

    <hr class="rule" style="margin-top: var(--space-section);" />

    <h2
      class="u-label"
      style="margin-top: var(--space-section); font-size: var(--text-caption); color: var(--color-ink-muted);"
    >
      Awards and recognition
    </h2>
    <div>
      {
        profile.awards.map((a, i) => (
          <div style={`display: flex; justify-content: space-between; gap: 1rem; padding-block: var(--space-note); ${i > 0 ? "border-top: 1px solid var(--color-hairline);" : ""}`}>
            <span class="fig" style="font-size: var(--text-note); color: var(--color-ink-muted); white-space: nowrap;">
              {a.date}
            </span>
            <span style="font-size: var(--text-body); color: var(--color-ink); text-align: right;">
              {a.title}
            </span>
          </div>
        ))
      }
    </div>
  </Sheet>
</Base>
