---
import Base from "../layouts/Base.astro";
import Masthead from "../components/Masthead.astro";
import { profile } from "../data/profile";
---

<Base
  title="Research - Varun Malhotra"
  description="Two peer-reviewed papers on visual grounding for web agents and generative 3D reconstruction, both grown out of production problems at Michelin and Samsung."
>
  <Masthead
    title="Research"
    standfirst="Two peer-reviewed papers, both grown out of production problems rather than the other way round."
  />
  <section>
    <div class="wrap">
      <div class="kicker">
        <span class="idx">01</span>
        <h2>Publications</h2>
        <span class="rule"></span>
      </div>
      {
        profile.publications.map((p) => (
          <div class="pub-row">
            <div class="venue mono">{p.venue}</div>
            <div>
              <h3>{p.title}</h3>
              {/* Same rule as the home page: `note` already contains "peer-reviewed",
                  so the tag would repeat it. Print only what the tag does not cover. */}
              {p.note.replace(/\s*·?\s*peer-reviewed\s*/i, "").trim() && (
                <p>{p.note.replace(/\s*·?\s*peer-reviewed\s*/i, "").trim()}</p>
              )}
              <p class="detail">{p.detail}</p>
            </div>
            {p.note.toLowerCase().includes("peer-reviewed") && (
              <div class="tag">Peer-reviewed</div>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="kicker">
        <span class="idx">02</span>
        <h2>Awards and recognition</h2>
        <span class="rule"></span>
      </div>
      {
        profile.awards.map((a) => (
          <div class="list-row">
            <span class="list-row-date mono">{a.date}</span>
            <span class="list-row-title">{a.title}</span>
          </div>
        ))
      }
    </div>
  </section>
</Base>
