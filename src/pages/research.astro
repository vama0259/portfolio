---
import Base from "../layouts/Base.astro";
import Sheet from "../components/Sheet.astro";
import { profile } from "../data/profile";
---

<Base title="Research - Varun Malhotra">
  <Sheet rail={false}>
    <h1
      class="u-display page-title"
    >
      Research
    </h1>
    <p class="page-standfirst">
      Two peer-reviewed papers, both grown out of production problems rather than the other way round.
    </p>

    <div class="section-rule">
      {
        profile.publications.map((p) => (
          <div class="pub-row">
            <p class="fig pub-venue">
              {p.venue}
              {p.note.includes("First author") && (
                <span class="u-label pub-badge">
                  First author
                </span>
              )}
            </p>
            <h2 class="pub-title-compact">
              {p.title}
            </h2>
            <p class="pub-note-tight">{p.note.replace(/^First author\s*[·-]\s*/, "")}</p>
            <p class="pub-detail">
              {p.detail}
            </p>
          </div>
        ))
      }
    </div>

    <hr class="rule section-rule" />

    <h2
      class="u-label section-heading"
    >
      Awards and recognition
    </h2>
    <div>
      {
        profile.awards.map((a) => (
          <div class="list-row">
            <span class="fig list-row-date">
              {a.date}
            </span>
            <span class="list-row-value">
              {a.title}
            </span>
          </div>
        ))
      }
    </div>
  </Sheet>
</Base>
