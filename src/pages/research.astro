---
import Base from "../layouts/Base.astro";
import Masthead from "../components/Masthead.astro";
import { profile } from "../data/profile";
---

<Base title="Research - Varun Malhotra">
  <Masthead
    title="Research"
    standfirst="Two peer-reviewed papers, both grown out of production problems rather than the other way round."
  />
  <section>
    <div class="wrap">
      <div class="kicker">
        <span class="idx">01</span>
        <h2>Publications</h2>
        <span class="rule"></span>
      </div>
      {
        profile.publications.map((p) => (
          <div class="pub-row">
            <div class="venue mono">{p.venue}</div>
            <div>
              <h3>{p.title}</h3>
              <p>{p.note}</p>
              <p class="detail">{p.detail}</p>
            </div>
            <div class="tag">{p.note.includes("peer-reviewed") ? "Peer-reviewed" : ""}</div>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="kicker">
        <span class="idx">02</span>
        <h2>Awards and recognition</h2>
        <span class="rule"></span>
      </div>
      {
        profile.awards.map((a) => (
          <div class="list-row">
            <span class="list-row-date mono">{a.date}</span>
            <span class="list-row-title">{a.title}</span>
          </div>
        ))
      }
    </div>
  </section>
</Base>
