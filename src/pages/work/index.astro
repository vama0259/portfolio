---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Sheet from "../../components/Sheet.astro";
import Figures from "../../components/Figures.astro";
import Entry from "../../components/Entry.astro";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Work - Varun Malhotra">
  <Sheet>
    <h1
      class="u-display page-title"
    >
      Work
    </h1>
    <p class="page-standfirst">
      Three systems, each ending with the trade-off it made and what I would build differently now.
    </p>
  </Sheet>

  <Sheet class="full">
    {
      work.map((entry) => (
        <Fragment>
          <Entry
            slug={entry.id}
            title={entry.data.title}
            tagline={entry.data.tagline}
            status={entry.data.status}
            period={entry.data.period}
            stack={entry.data.stack}
          />
          <Figures metrics={entry.data.metrics.slice(0, 2)} prefix={entry.id} />
        </Fragment>
      ))
    }
  </Sheet>
</Base>
