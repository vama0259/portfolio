---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Masthead from "../../components/Masthead.astro";
import Entry from "../../components/Entry.astro";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);

const site = Astro.site;
const listLd = {
  "@type": "CollectionPage",
  name: "Work — Varun Malhotra",
  url: new URL("/work", site).toString(),
  isPartOf: { "@id": `${site}#website` },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: work.map((entry, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: entry.data.title,
      url: new URL(`/work/${entry.id}`, site).toString(),
    })),
  },
};
---

<Base
  title="Work - Varun Malhotra"
  description="LLM and ML case studies plus an open-source agent supervisor, each explaining its evidence, architecture and trade-offs."
  schemas={[listLd]}
  breadcrumbs={[{ name: "Work", path: "/work" }]}
  navSticky
>
  <Masthead
    title="Work"
    standfirst="Systems and open-source workflows, each ending with the trade-off it made and what I would build differently now."
  />
  <section>
    <div class="wrap">
      <div class="work-list">
        {
          work.map((entry, i) => (
            <Entry
              slug={entry.id}
              index={i + 1}
              title={entry.data.title}
              tagline={entry.data.tagline}
              status={entry.data.status}
              period={entry.data.period}
              stack={entry.data.stack}
              metrics={entry.data.metrics}
              revealIndex={i}
            />
          ))
        }
      </div>
    </div>
  </section>
</Base>
