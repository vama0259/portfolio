---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Figures from "../../components/Figures.astro";
import Figure1 from "../../components/Figure1.astro";

export async function getStaticPaths() {
  const work = await getCollection("work");
  return work.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const all = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((e) => e.id === entry.id);
const next = all[(idx + 1) % all.length];

// The tagline alone is a 70-character description that spends none of its
// budget on what the system is or what it achieved. Pad it with the first
// sentence of `problem` and the headline metric, then trim on a word boundary
// so the SERP snippet ends in a word rather than mid-syllable.
const firstProblemSentence = d.problem.replace(/\s+/g, " ").split(/(?<=\.)\s/)[0];
const rawDescription = `${d.tagline} ${firstProblemSentence} ${d.metrics[0].label}: ${d.metrics[0].value} (${d.metrics[0].basis}).`;
const description =
  rawDescription.length <= 158
    ? rawDescription
    : `${rawDescription.slice(0, 155).replace(/\s+\S*$/, "")}…`;

// `title` in the schema is the case study's own name; the <title> tag adds the
// site name because a SERP result needs to say whose work this is.
const caseLd = {
  "@type": "Article",
  headline: d.title,
  name: d.title,
  description: d.tagline,
  about: d.stack,
  url: new URL(`/work/${entry.id}`, Astro.site).toString(),
  mainEntityOfPage: new URL(`/work/${entry.id}`, Astro.site).toString(),
  image: new URL("/og-image.png", Astro.site).toString(),
  author: { "@id": `${Astro.site}#person` },
  publisher: { "@id": `${Astro.site}#person` },
  isPartOf: { "@id": `${Astro.site}#website` },
  keywords: d.stack.join(", "),
};
---

<Base
  title={`${d.title} — case study | Varun Malhotra`}
  description={description}
  ogType="article"
  schemas={[caseLd]}
  breadcrumbs={[{ name: "Work", path: "/work" }, { name: d.title, path: `/work/${entry.id}` }]}
  navSticky
>
  <article>
    <div class="wrap" style="padding-top: 3.2rem;">
      <p class="mono" style="font-size:0.72rem; color: var(--color-muted);">
        {/* Wrapped as a breadcrumb because the page emits a BreadcrumbList —
            structured data is supposed to describe something the reader can
            also see, and the trail was already here in everything but name. */}
        <nav aria-label="Breadcrumb" style="display:inline;">
          <a href="/" class="text-muted">Home</a>
          <span aria-hidden="true"> / </span>
          <a href="/work" class="text-muted">Work</a>
        </nav><br />
        <span class="mono">{d.period}</span><br />
        {d.status === "production" ? <span class="status-live">&#9679; production</span> : <span>{d.status}</span>}
      </p>

      <h1 class="display page-title" style="margin-top: 1rem;">{d.title}</h1>
      <p class="case-tagline">{d.tagline}</p>

      {
        entry.id === "talk-to-data" && (
          <p class="case-owned">Owned: agent architecture, LLMOps stack, security model, frontend.</p>
        )
      }

      <p class="case-problem">{d.problem}</p>

      <ul class="stack-list">
        {d.stack.map((s) => <li class="mono stack-item">{s}</li>)}
      </ul>
    </div>

    <section style="border-top: 1px solid var(--color-line); margin-top: 2.5rem;">
      <div class="wrap">
        <div class="kicker">
          <span class="idx">01</span>
          <h2>Results, plotted</h2>
          <span class="rule"></span>
        </div>
        <Figures metrics={d.metrics} prefix={entry.id} />
      </div>
    </section>

    {
      d.trace && (
        <section id="diagram">
          <div class="wrap">
            <div class="kicker">
              <span class="idx">02</span>
              <h2>Fig. 1 &mdash; the ReAct loop, operated</h2>
              <span class="rule"></span>
            </div>
            <Figure1 steps={d.trace} caption={`${d.title}, ${d.status}. Guarded steps marked.`} />
          </div>
        </section>
      )
    }

    <div class="wrap">
      <div class="prose">
        <Content />

        <h2>Trade-off</h2>
        <p>{d.tradeoff}</p>

        <h2><span class="accent-mark">&#9670;</span> What I would build differently</h2>
        <p>{d.wouldChange}</p>
      </div>

      <nav class="case-nav">
        <a href={`/work/${next.id}`} class="case-nav-link">
          <span>
            <span class="case-nav-eyebrow">Next case study</span>
            <span class="case-nav-title">{next.data.title}</span>
          </span>
          <span aria-hidden="true" class="case-nav-arrow">&rarr;</span>
        </a>
      </nav>
    </div>
  </article>
</Base>
