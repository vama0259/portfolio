---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Figures from "../../components/Figures.astro";
import Figure1 from "../../components/Figure1.astro";

export async function getStaticPaths() {
  const work = await getCollection("work");
  return work.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const all = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((e) => e.id === entry.id);
const next = all[(idx + 1) % all.length];
---

<Base title={`${d.title} - Varun Malhotra`} description={d.tagline} navSticky>
  <article>
    <div class="wrap" style="padding-top: 3.2rem;">
      <p class="mono" style="font-size:0.72rem; color: var(--color-muted);">
        <a href="/work" class="text-muted">Work</a><br />
        <span class="mono">{d.period}</span><br />
        {d.status === "production" ? <span class="status-live">&#9679; production</span> : <span>{d.status}</span>}
      </p>

      <h1 class="display page-title" style="margin-top: 1rem;">{d.title}</h1>
      <p class="case-tagline">{d.tagline}</p>

      {
        entry.id === "talk-to-data" && (
          <p class="case-owned">Owned: agent architecture, LLMOps stack, security model, frontend.</p>
        )
      }

      <p class="case-problem">{d.problem}</p>

      <ul class="stack-list">
        {d.stack.map((s) => <li class="mono stack-item">{s}</li>)}
      </ul>
    </div>

    <section style="border-top: 1px solid var(--color-line); margin-top: 2.5rem;">
      <div class="wrap">
        <div class="kicker">
          <span class="idx">01</span>
          <h2>Results, plotted</h2>
          <span class="rule"></span>
        </div>
        <Figures metrics={d.metrics} prefix={entry.id} />
      </div>
    </section>

    {
      d.trace && (
        <section id="diagram">
          <div class="wrap">
            <div class="kicker">
              <span class="idx">02</span>
              <h2>Fig. 1 &mdash; the ReAct loop, operated</h2>
              <span class="rule"></span>
            </div>
            <Figure1 steps={d.trace} caption={`${d.title}, ${d.status}. Guarded steps marked.`} />
          </div>
        </section>
      )
    }

    <div class="wrap">
      <div class="prose">
        <Content />

        <h2>Trade-off</h2>
        <p>{d.tradeoff}</p>

        <h2><span class="accent-mark">&#9670;</span> What I would build differently</h2>
        <p>{d.wouldChange}</p>
      </div>

      <nav class="case-nav">
        <a href={`/work/${next.id}`} class="case-nav-link">
          <span>
            <span class="case-nav-eyebrow">Next case study</span>
            <span class="case-nav-title">{next.data.title}</span>
          </span>
          <span aria-hidden="true" class="case-nav-arrow">&rarr;</span>
        </a>
      </nav>
    </div>
  </article>
</Base>
