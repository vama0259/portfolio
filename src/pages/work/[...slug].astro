---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import MetricStrip from "../../components/MetricStrip.astro";
import AgentTrace from "../../components/AgentTrace.astro";

export async function getStaticPaths() {
  const work = await getCollection("work");
  return work.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const all = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((e) => e.id === entry.id);
const next = all[(idx + 1) % all.length];

const statusColor = {
  production: "text-live border-live/30 bg-live/5",
  research: "text-signal border-signal/30 bg-signal/5",
  shipped: "text-ink-muted border-line-bright bg-raised",
}[d.status];
---

<Base title={`${d.title} — Varun Malhotra`} description={d.tagline}>
  <!-- ══ Header ════════════════════════════════════════════════════════ -->
  <article>
    <header class="mx-auto max-w-4xl px-6 pb-14 pt-24">
      <div class="mb-7 flex items-center gap-3">
        <a
          href="/work"
          class="font-mono text-xs uppercase tracking-[0.14em] text-ink-dim transition-colors hover:text-signal"
        >
          ← Work
        </a>
        <span aria-hidden="true" class="text-ink-dim">/</span>
        <span class="num text-xs text-ink-dim">{d.period}</span>
        <span
          class:list={[
            "border px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.14em]",
            statusColor,
          ]}
        >
          {d.status}
        </span>
      </div>

      <h1
        class="text-title font-medium leading-[1.05] tracking-[-0.02em] text-ink"
      >
        {d.title}
      </h1>

      <p class="mt-5 text-xl leading-relaxed text-signal">{d.tagline}</p>

      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-ink-muted">
        {d.problem}
      </p>
    </header>

    <!-- ══ Metrics ═════════════════════════════════════════════════════ -->
    <div class="mx-auto max-w-4xl px-6">
      <MetricStrip metrics={d.metrics} size="lg" />

      <ul class="mt-6 flex flex-wrap gap-x-2 gap-y-2 border-b border-line pb-10">
        {
          d.stack.map((s) => (
            <li class="border border-line bg-raised px-2.5 py-1 font-mono text-[11px] text-ink-muted">
              {s}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- ══ Trace ═══════════════════════════════════════════════════════ -->
    {
      d.trace && (
        <div class="mx-auto max-w-4xl px-6">
          <AgentTrace
            steps={d.trace}
            caption="One query, end to end. Scroll to step through it."
          />
        </div>
      )
    }

    <!-- ══ Body ════════════════════════════════════════════════════════ -->
    <div class="prose-panel mx-auto max-w-4xl px-6">
      <Content />
    </div>

    <!-- ══ The honest bit ══════════════════════════════════════════════ -->
    <section class="mx-auto mt-20 max-w-4xl px-6">
      <div class="grid gap-px border border-line bg-line md:grid-cols-2">
        <div class="reveal bg-surface p-7">
          <p class="label mb-4">What it cost</p>
          <p class="text-base leading-relaxed text-ink-muted">{d.tradeoff}</p>
        </div>
        <div class="reveal bg-surface p-7">
          <p class="label mb-4 text-signal">What I'd change</p>
          <p class="text-base leading-relaxed text-ink-muted">
            {d.wouldChange}
          </p>
        </div>
      </div>
    </section>

    <!-- ══ Next ════════════════════════════════════════════════════════ -->
    <nav class="mx-auto mt-20 max-w-4xl px-6">
      <a
        href={`/work/${next.id}`}
        class="group flex items-center justify-between gap-6 border-t border-line py-8 transition-colors hover:border-line-bright"
      >
        <span>
          <span class="label mb-2 block">Next case study</span>
          <span
            class="text-heading font-medium text-ink transition-colors group-hover:text-signal"
          >
            {next.data.title}
          </span>
        </span>
        <span
          aria-hidden="true"
          class="text-2xl text-ink-dim transition-all duration-300 group-hover:translate-x-1 group-hover:text-signal"
        >
          →
        </span>
      </a>
    </nav>
  </article>
</Base>

<style is:global>
  /* Prose, hand-rolled rather than plugin-driven so the measure, rhythm and
     rule weights match the rest of the instrument panel. */
  .prose-panel {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-ink-muted);
  }

  .prose-panel > * + * {
    margin-top: 1.5rem;
  }

  .prose-panel h2 {
    margin-top: 3.5rem;
    margin-bottom: 0.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .prose-panel h3 {
    margin-top: 2.5rem;
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .prose-panel p {
    max-width: 68ch;
  }

  .prose-panel strong {
    font-weight: 500;
    color: var(--color-ink);
  }

  .prose-panel a {
    color: var(--color-signal);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose-panel code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    color: var(--color-ink);
    background: var(--color-raised);
    border: 1px solid var(--color-line);
    padding: 0.1em 0.4em;
  }

  .prose-panel ul {
    list-style: none;
    padding-left: 0;
  }

  .prose-panel li {
    position: relative;
    padding-left: 1.4rem;
    max-width: 68ch;
  }

  .prose-panel li + li {
    margin-top: 0.5rem;
  }

  .prose-panel li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.5rem;
    height: 1px;
    background: var(--color-signal);
  }
</style>
