---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Sheet from "../../components/Sheet.astro";
import Figures from "../../components/Figures.astro";
import Figure1 from "../../components/Figure1.astro";

export async function getStaticPaths() {
  const work = await getCollection("work");
  return work.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const all = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((e) => e.id === entry.id);
const next = all[(idx + 1) % all.length];
---

<Base title={`${d.title} - Varun Malhotra`} description={d.tagline} navSticky>
  <article>
    <Sheet>
      <p class="rail u-label" style="margin-top: var(--space-page); font-size: var(--text-caption); color: var(--color-ink-muted);">
        <a href="/work" style="color: var(--color-ink-muted);">Work</a><br />
        <span class="fig" style="font-size: var(--text-note);">{d.period}</span><br />
        {
          d.status === "production" ? (
            <span style="color: var(--color-accent);">● production</span>
          ) : (
            <span>{d.status}</span>
          )
        }
      </p>

      <div style="margin-top: var(--space-page);">
        <h1
          class="u-display"
          style="font-size: var(--text-display); line-height: var(--text-display--line-height); letter-spacing: -0.02em; color: var(--color-ink);"
        >
          {d.title}
        </h1>
        <p style="margin-top: var(--space-tight); font-size: var(--text-lede); line-height: var(--text-lede--line-height); color: var(--color-ink-muted);">
          {d.tagline}
        </p>

        {
          entry.id === "talk-to-data" && (
            <p class="u-label" style="margin-top: var(--space-block); font-size: var(--text-caption); color: var(--color-ink-muted);">
              Owned: agent architecture, LLMOps stack, security model, frontend.
            </p>
          )
        }

        <p style="margin-top: var(--space-block); font-size: var(--text-lede); line-height: var(--text-lede--line-height); color: var(--color-ink);">
          {d.problem}
        </p>
      </div>

      <Figures metrics={d.metrics} prefix={entry.id} />

      <ul class="breakout" style="margin-top: var(--space-block); padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem;">
        {
          d.stack.map((s) => (
            <li class="u-label" style="font-size: var(--text-caption); color: var(--color-ink-muted);">
              {s}
            </li>
          ))
        }
      </ul>

      {
        d.trace && (
          <Figure1 steps={d.trace} caption={`ReAct loop, ${d.title}. Guarded steps marked.`} />
        )
      }

      <div class="prose" style="margin-top: var(--space-section);">
        <Content />

        <h2>Trade-off</h2>
        <p>{d.tradeoff}</p>

        <h2>
          <span style="color: var(--color-accent);">&#9670;</span> What I would build differently
        </h2>
        <p>{d.wouldChange}</p>
      </div>

      <nav style="margin-top: var(--space-section); padding-top: var(--space-block); border-top: 1px solid var(--color-rule);">
        <a href={`/work/${next.id}`} style="display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; text-decoration: none;">
          <span>
            <span class="u-label" style="display: block; font-size: var(--text-caption); color: var(--color-ink-muted);">
              Next case study
            </span>
            <span style="font-family: var(--font-text); font-weight: 600; font-size: var(--text-h2); color: var(--color-ink);">
              {next.data.title}
            </span>
          </span>
          <span aria-hidden="true" class="fig" style="color: var(--color-ink-muted);">-&gt;</span>
        </a>
      </nav>
    </Sheet>
  </article>
</Base>
