---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Sheet from "../../components/Sheet.astro";
import Figures from "../../components/Figures.astro";
import Figure1 from "../../components/Figure1.astro";

export async function getStaticPaths() {
  const work = await getCollection("work");
  return work.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const all = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((e) => e.id === entry.id);
const next = all[(idx + 1) % all.length];
---

<Base title={`${d.title} - Varun Malhotra`} description={d.tagline} navSticky>
  <article>
    <Sheet rail>
      <p class="rail u-label case-meta">
        <a href="/work" class="text-muted">Work</a><br />
        <span class="fig case-period">{d.period}</span><br />
        {
          d.status === "production" ? (
            <span class="status-live">● production</span>
          ) : (
            <span>{d.status}</span>
          )
        }
      </p>

      <div class="case-header">
        <h1
          class="u-display display-title"
        >
          {d.title}
        </h1>
        <p class="case-tagline">
          {d.tagline}
        </p>

        {
          entry.id === "talk-to-data" && (
            <p class="u-label case-owned">
              Owned: agent architecture, LLMOps stack, security model, frontend.
            </p>
          )
        }

        <p class="case-problem">
          {d.problem}
        </p>
      </div>

      <Figures metrics={d.metrics} prefix={entry.id} />

      <ul class="breakout stack-list">
        {
          d.stack.map((s) => (
            <li class="u-label stack-item">
              {s}
            </li>
          ))
        }
      </ul>

      {
        d.trace && (
          <Figure1 steps={d.trace} caption={`ReAct loop, ${d.title}. Guarded steps marked.`} />
        )
      }

      <div class="prose prose-spaced">
        <Content />

        <h2>Trade-off</h2>
        <p>{d.tradeoff}</p>

        <h2>
          <span class="accent-mark">&#9670;</span> What I would build differently
        </h2>
        <p>{d.wouldChange}</p>
      </div>

      <nav class="case-nav">
        <a href={`/work/${next.id}`} class="case-nav-link">
          <span>
            <span class="u-label case-nav-eyebrow">
              Next case study
            </span>
            <span class="case-nav-title">
              {next.data.title}
            </span>
          </span>
          <span aria-hidden="true" class="fig case-nav-arrow">-&gt;</span>
        </a>
      </nav>
    </Sheet>
  </article>
</Base>
