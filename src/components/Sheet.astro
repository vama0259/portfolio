---
/**
 * Thin wrap around the mockup's `.wrap` max-width column. Kept as a
 * component (rather than inlining the class everywhere) so page markup
 * reads the same as before the port.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div class:list={["wrap", className]}>
  <slot />
</div>
