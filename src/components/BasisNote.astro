---
/**
 * The basis caption — "Basis — <source>", mono, uppercase, muted. Printed
 * directly under a chart title (Figures.astro) so every metric's source is
 * visible without a hover or a separate rail; works identically with JS on
 * or off.
 */
interface Props {
  basis: string;
}
const { basis } = Astro.props;
---

<div class="basis">Basis &mdash; {basis}</div>
