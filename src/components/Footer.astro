---
import { profile } from "../data/profile";

const year = new Date().getFullYear();

const channels = [
  { label: "Email", value: profile.email, href: `mailto:${profile.email}` },
  { label: "LinkedIn", value: "in/vama0259", href: profile.linkedin },
  { label: "GitHub", value: "vama0259", href: profile.github },
];
---

<footer class="mt-32 border-t border-line">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid gap-10 md:grid-cols-[1fr_auto]">
      <div class="max-w-md">
        <p class="label mb-3">Open to</p>
        <p class="text-lg leading-relaxed text-ink-muted">
          LLM and agent engineering roles where the system has to survive
          contact with real users.
        </p>
      </div>

      <dl class="grid gap-3 sm:grid-cols-3 md:gap-8">
        {
          channels.map((c) => (
            <div>
              <dt class="label mb-1.5">{c.label}</dt>
              <dd>
                <a
                  href={c.href}
                  class="link-underline font-mono text-sm text-ink transition-colors hover:text-signal"
                >
                  {c.value}
                </a>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div
      class="mt-14 flex flex-col gap-2 border-t border-line pt-6 font-mono text-xs text-ink-dim sm:flex-row sm:items-center sm:justify-between"
    >
      <span>© {year} {profile.name} · {profile.location}</span>
      <span aria-hidden="true">Built with Astro · deployed on Cloudflare</span>
    </div>
  </div>
</footer>
