---
/**
 * Page header. Name/title in Archivo at --text-display, one Spectral line
 * beneath, closed by a single --color-rule line spanning `full`. No nav
 * inside it.
 */
interface Props {
  title: string;
  standfirst?: string;
}

const { title, standfirst } = Astro.props;
---

<header class="full masthead">
  <div class="sheet masthead-inner">
    <h1
      class="u-display display-title masthead-title"
      set:html={title}
    />
    {
      standfirst && (
        <p
          class="masthead-standfirst"
        >
          {standfirst}
        </p>
      )
    }
  </div>
  <hr class="rule" />
</header>
