---
/**
 * Page header. Name/title in Archivo at --text-display, one Spectral line
 * beneath, closed by a single --color-rule line spanning `full`. No nav
 * inside it.
 */
interface Props {
  title: string;
  standfirst?: string;
}

const { title, standfirst } = Astro.props;
---

<header class="full" style="grid-column: full;">
  <div class="sheet" style="padding-top: var(--space-page); padding-bottom: var(--space-block);">
    <h1
      class="u-display"
      style="font-size: var(--text-display); line-height: var(--text-display--line-height); letter-spacing: -0.02em; color: var(--color-ink); grid-column: measure;"
      set:html={title}
    />
    {
      standfirst && (
        <p
          style="margin-top: var(--space-para); font-size: var(--text-lede); line-height: var(--text-lede--line-height); color: var(--color-ink-muted); grid-column: measure;"
        >
          {standfirst}
        </p>
      )
    }
  </div>
  <hr class="rule" />
</header>
