---
/**
 * Page header for /work, /research, /about — title + standfirst, closed by
 * a hairline. The home page uses its own hero (see index.astro); this is
 * for the plainer interior pages.
 */
interface Props {
  title: string;
  standfirst?: string;
}
const { title, standfirst } = Astro.props;
---

<header class="wrap" style="padding-top: 3.2rem; padding-bottom: 2rem;">
  <h1 class="display page-title" set:html={title} />
  {standfirst && <p class="page-standfirst">{standfirst}</p>}
</header>
