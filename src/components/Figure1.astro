---
/**
 * Fig. 1 — the ReAct loop, operated. Built entirely from a case study's
 * `trace` frontmatter (array of {step, detail, emphasis?}) — any case study
 * defining `trace` gets this diagram with no template change. Server-rendered
 * as a complete, readable trace first; a vanilla-JS layer (no framework, no
 * library) then upgrades it into the reader-driven step/reset control and,
 * when the trace contains a step that reads as the guardrail, the
 * query-vs-guardrail demo from the approved mockup.
 *
 * Progressive enhancement: every `<button>` here is a real button, works
 * with no JS (the printed trace is complete on its own), and the console +
 * verdict panel are `aria-live="polite"`.
 */
interface Step {
  step: string;
  detail: string;
  emphasis?: boolean;
}

interface Props {
  steps: readonly Step[];
  caption: string;
  /** Auto-detected if omitted: an emphasis step whose text reads as a guardrail. */
  guardrail?: boolean;
}

const { steps, caption } = Astro.props;
const guardrailIndex = steps.findIndex((s) => s.emphasis && /guard|read-only|write/i.test(s.step + s.detail));
const showGuardrailDemo = Astro.props.guardrail ?? guardrailIndex >= 0;
const n = steps.length;
---

<div class="diagram-shell" data-fig1 data-guardrail-index={guardrailIndex}>
  <div class="diagram-toolbar">
    <div class="title" data-toolbar-title>Trace &mdash; step 0 / {n}</div>
    <div class="diagram-controls">
      <button type="button" class="btn ghost" data-reset>Reset</button>
      <button type="button" class="btn" data-step-btn>Step &rarr;</button>
    </div>
  </div>

  <div class="react-track">
    {
      steps.map((s, i) => (
        <button
          type="button"
          class:list={["react-step", s.emphasis && "critical"]}
          data-step={i + 1}
          aria-label={`Step ${i + 1} of ${n}: ${s.step}${s.emphasis ? ", critical step" : ""}`}
        >
          {i < n - 1 && (
            <div class="react-arrow">
              <span class="dot" />
            </div>
          )}
          <span class="n mono">{String(i + 1).padStart(2, "0")}</span>
          <h4>{s.step}</h4>
          <p>{s.detail}</p>
          {s.emphasis && <span class="flag">Critical step</span>}
        </button>
      ))
    }
  </div>

  <div class="react-console" data-console aria-live="polite">
    <div class="line mono">$ <span class="p">awaiting input</span> <span class="cursor" /></div>
  </div>

  {
    showGuardrailDemo && (
      <div class="guardrail-demo">
        <div class="col">
          <h5>Try a query</h5>
          <button class="qbtn" data-q="read" data-text="What was Q3 revenue for the Iberia market?">
            SELECT-style &middot; "What was Q3 revenue for the Iberia market?"
          </button>
          <button class="qbtn" data-q="read" data-text="Which analysts ran the most queries last week?">
            SELECT-style &middot; "Which analysts ran the most queries last week?"
          </button>
          <button class="qbtn write" data-q="write" data-text="Update the Iberia Q3 revenue figure to 4.2M.">
            WRITE attempt &middot; "Update the Iberia Q3 revenue figure to 4.2M."
          </button>
          <button class="qbtn write" data-q="write" data-text="Drop the stale pricing_backup table.">
            DDL attempt &middot; "Drop the stale pricing_backup table."
          </button>
        </div>
        <div class="col">
          <h5>Guardrail verdict</h5>
          <div class="verdict" data-verdict aria-live="polite">
            Select a query on the left to run it through the guardrail.
          </div>
        </div>
      </div>
    )
  }

  <p class="sr-only" data-status role="status" aria-live="polite" />
  <figcaption class="mono" style="font-size:0.68rem; color: var(--color-muted); border-top: 1px solid var(--color-line); padding: 0.8rem 1.2rem;">
    Fig. 1 &mdash; {caption}
  </figcaption>
</div>

<script>
  function initFigure1(shell: HTMLElement) {
    const steps = Array.from(shell.querySelectorAll<HTMLButtonElement>(".react-step"));
    const arrows = steps.map((s) => s.querySelector<HTMLElement>(".react-arrow"));
    const stepBtn = shell.querySelector<HTMLButtonElement>("[data-step-btn]");
    const resetBtn = shell.querySelector<HTMLButtonElement>("[data-reset]");
    const title = shell.querySelector<HTMLElement>("[data-toolbar-title]");
    const consoleEl = shell.querySelector<HTMLElement>("[data-console]");
    if (!stepBtn || !resetBtn || !title || !consoleEl || steps.length === 0) return;

    const total = steps.length;
    const guardrailIndex = Number(shell.dataset.guardrailIndex ?? "-1");
    let current = 0;

    function stepLog(n: number) {
      const s = steps[n - 1];
      const name = s.querySelector("h4")?.textContent ?? "";
      const detail = s.querySelector("p")?.textContent ?? "";
      return `$ <span class="p">${name}</span> &rarr; ${detail}`;
    }

    function logLine(html: string, cls?: string) {
      const d = document.createElement("div");
      d.className = "line mono" + (cls ? " " + cls : "");
      d.innerHTML = html;
      consoleEl!.appendChild(d);
      consoleEl!.scrollTop = consoleEl!.scrollHeight;
    }

    function renderConsole(upto: number) {
      consoleEl!.innerHTML = "";
      for (let i = 1; i <= upto; i++) logLine(stepLog(i), "ok");
      if (upto === 0) logLine('$ <span class="p">awaiting input</span> <span class="cursor"></span>');
      else if (upto < total) logLine('$ <span class="p">next</span> <span class="cursor"></span>');
      else logLine('$ <span class="p">trace complete</span> <span class="cursor"></span>');
    }

    function renderSteps() {
      steps.forEach((s, i) => {
        const n = i + 1;
        s.classList.remove("active", "done");
        if (n < current) s.classList.add("done");
        if (n === current) s.classList.add("active");
      });
      title!.textContent = `Trace — step ${current} / ${total}`;
      stepBtn!.disabled = current >= total;
    }

    function updateArrows(newCurrent: number, justCrossed: number) {
      arrows.forEach((arrow, i) => {
        if (!arrow) return;
        arrow.classList.remove("blocked");
        const n = i + 1;
        arrow.classList.toggle("flowed", n < newCurrent);
      });
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (justCrossed > 0 && arrows[justCrossed - 1] && !reduce) {
        const a = arrows[justCrossed - 1]!;
        a.classList.remove("flowing");
        void a.offsetWidth;
        a.classList.add("flowing");
      }
    }

    function advance() {
      if (current >= total) return;
      current += 1;
      renderSteps();
      renderConsole(current);
      updateArrows(current, current - 1);
    }
    function reset() {
      current = 0;
      renderSteps();
      renderConsole(0);
      updateArrows(0, 0);
    }

    stepBtn.addEventListener("click", advance);
    resetBtn.addEventListener("click", reset);
    steps.forEach((s, i) => {
      s.addEventListener("click", () => {
        current = i + 1;
        renderSteps();
        renderConsole(current);
        updateArrows(current, current);
      });
    });
    renderSteps();
    updateArrows(0, 0);

    // ---- guardrail demo ----
    const qButtons = Array.from(shell.querySelectorAll<HTMLButtonElement>(".qbtn"));
    const verdict = shell.querySelector<HTMLElement>("[data-verdict]");
    const gateStep = guardrailIndex >= 0 ? steps[guardrailIndex] : null;
    const gateArrow = guardrailIndex >= 0 ? arrows[guardrailIndex] : null;

    qButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const kind = btn.dataset.q;
        const text = btn.dataset.text ?? "";
        if (!verdict) return;

        if (kind === "read") {
          verdict.className = "verdict pass";
          verdict.innerHTML = "<strong>PASS</strong> — read-only statement. Proceeds to execution.";
          logLine(`$ <span class="p">guardrail.check</span>("${text}") &rarr; SELECT-equivalent &rarr; PASS`, "ok");
          gateArrow?.classList.remove("blocked");
        } else {
          verdict.className = "verdict fail";
          verdict.innerHTML = "<strong>REJECTED</strong> — write/DDL detected. Statement never reaches the database.";
          logLine(`$ <span class="p">guardrail.check</span>("${text}") &rarr; WRITE/DDL detected &rarr; <strong>REJECTED</strong>`, "err");
          if (gateStep) {
            gateStep.classList.remove("rejecting");
            void gateStep.offsetWidth;
            const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            if (!reduce) gateStep.classList.add("rejecting");
            steps.forEach((s) => s.classList.remove("active"));
            gateStep.classList.add("active");
            title!.textContent = `Trace — step ${guardrailIndex + 1} / ${total} (blocked at guardrail)`;
            if (gateArrow) {
              gateArrow.classList.remove("flowed", "flowing", "blocked");
              void gateArrow.offsetWidth;
              if (!reduce) gateArrow.classList.add("blocked");
            }
          }
        }
      });
    });
  }

  document.querySelectorAll<HTMLElement>("[data-fig1]").forEach(initFigure1);
</script>
