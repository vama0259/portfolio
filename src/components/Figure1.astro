---
/**
 * The printed ReAct trace. Replaces AgentTrace.astro. A numbered vertical
 * sequence on --color-paper-raised, each step a row: ordinal in .fig, step
 * name in Archivo 600, detail in Spectral. emphasis:true steps carry a 2px
 * accent left rule and their detail set in --color-ink. Zero animation.
 */
interface Step {
  step: string;
  detail: string;
  emphasis?: boolean;
}

interface Props {
  steps: readonly Step[];
  number?: string;
  caption: string;
}

const { steps, number = "1", caption } = Astro.props;
---

<figure class="breakout" style="margin-block: var(--space-block); background-color: var(--color-paper-raised);">
  <ol style="list-style: none; padding: var(--space-block) 1.5rem; margin: 0; display: flex; flex-direction: column; gap: var(--space-block);">
    {
      steps.map((s, i) => (
        <li
          style={`display: grid; grid-template-columns: 2.5rem 1fr; gap: 1rem; padding-left: 1rem; border-left: ${s.emphasis ? "2px solid var(--color-accent)" : "2px solid transparent"};`}
        >
          <span class="fig" style="color: var(--color-ink-muted); font-size: var(--text-note);">
            {String(i + 1).padStart(2, "0")}
          </span>
          <div>
            <h4
              class="u-label"
              style={`font-size: var(--text-body); color: ${s.emphasis ? "var(--color-ink)" : "var(--color-ink)"};`}
            >
              {s.step}
            </h4>
            <p
              style={`margin-top: 0.25rem; font-size: var(--text-note); line-height: var(--text-note--line-height); color: ${s.emphasis ? "var(--color-ink)" : "var(--color-ink-muted)"};`}
            >
              {s.detail}
            </p>
          </div>
        </li>
      ))
    }
  </ol>
  <figcaption
    class="u-label"
    style="font-size: var(--text-caption); color: var(--color-ink-muted); border-top: 1px solid var(--color-hairline); padding: var(--space-note) 1.5rem;"
  >
    Fig. {number} - {caption}
  </figcaption>
</figure>
