---
/**
 * Footer. Left: contact lines. Right: a build line with only the year and
 * the type credit. No version string, no build number, no sync timestamp.
 */
import { profile } from "../data/profile";

const year = new Date().getFullYear();
const channels = [
  { label: "Email", value: profile.email, href: `mailto:${profile.email}` },
  { label: "LinkedIn", value: "in/vama0259", href: profile.linkedin },
  { label: "GitHub", value: "vama0259", href: profile.github },
];
---

<footer class="full site-footer">
  <div class="sheet footer-inner">
    <div class="full footer-row">
      <ul class="footer-channels">
        {
          channels.map((c) => (
            <li>
              <p class="u-label footer-channel-label">
                {c.label}
              </p>
              <a href={c.href} class="fig footer-channel-value">
                {c.value}
              </a>
            </li>
          ))
        }
      </ul>

      <p class="u-label footer-meta">
        {year}. Set in Spectral, Archivo and Martian Mono.
      </p>
    </div>
  </div>
</footer>
