---
/**
 * Footer. Left: contact channels. Right: year + type credit. Matches
 * mockups/c-technical.html footer, extended with the channel list the old
 * design carried (kept — more useful than the mockup's placeholder line).
 */
import { profile } from "../data/profile";

const year = new Date().getFullYear();
const channels = [
  { label: "Email", value: profile.email, href: `mailto:${profile.email}` },
  { label: "LinkedIn", value: "in/vama0259", href: profile.linkedin },
  { label: "GitHub", value: "vama0259", href: profile.github },
];
---

<footer class="site-footer">
  <ul class="footer-channels">
    {
      channels.map((c) => (
        <li>
          <p class="footer-channel-label">{c.label}</p>
          <a href={c.href} class="footer-channel-value">{c.value}</a>
        </li>
      ))
    }
  </ul>
  <span class="footer-meta">&copy; {year} {profile.name} &mdash; Swiss Technical</span>
</footer>
