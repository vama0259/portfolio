---
import { getCollection } from "astro:content";
import { profile } from "../data/profile";

/**
 * ⌘K palette. Vanilla TypeScript on a native <dialog>.
 *
 * `<dialog>` supplies the focus trap, the backdrop and Esc-to-close for free,
 * which is most of what a headless component library would have been for. The
 * React alternative (cmdk) would have pulled the whole React runtime back in
 * for something that fits in a few KB.
 */

const work = (await getCollection("work")).sort(
  (a, b) => a.data.order - b.data.order,
);

type Item = {
  label: string;
  hint: string;
  group: string;
  href: string;
  keywords: string;
};

const items: Item[] = [
  ...work.map((w) => ({
    label: w.data.title,
    hint: w.data.tagline,
    group: "Case studies",
    href: `/work/${w.id}`,
    keywords: [w.data.title, ...w.data.stack, w.data.status].join(" "),
  })),
  ...work.flatMap((w) =>
    w.data.metrics.map((m) => ({
      label: `${m.value} — ${m.label}`,
      hint: `${w.data.title} · ${m.basis}`,
      group: "Metrics",
      href: `/work/${w.id}`,
      keywords: `${m.label} ${m.value} ${m.basis} ${w.data.title}`,
    })),
  ),
  ...profile.publications.map((p) => ({
    label: p.title,
    hint: `${p.venue} · ${p.note}`,
    group: "Research",
    href: "/research",
    keywords: `${p.title} ${p.venue} paper publication`,
  })),
  {
    label: "Work",
    hint: "All case studies",
    group: "Pages",
    href: "/work",
    keywords: "work projects case studies",
  },
  {
    label: "Research",
    hint: "Publications and recognition",
    group: "Pages",
    href: "/research",
    keywords: "research papers publications awards",
  },
  {
    label: "About",
    hint: "Trajectory, tools, education",
    group: "Pages",
    href: "/about",
    keywords: "about background education skills",
  },
  {
    label: "Email",
    hint: profile.email,
    group: "Contact",
    href: `mailto:${profile.email}`,
    keywords: "email contact hire reach out",
  },
  {
    label: "LinkedIn",
    hint: "in/vama0259",
    group: "Contact",
    href: profile.linkedin,
    keywords: "linkedin social profile",
  },
  {
    label: "GitHub",
    hint: "vama0259",
    group: "Contact",
    href: profile.github,
    keywords: "github code repositories",
  },
];
---

{/* The trigger lives in Nav.astro — the script binds every [data-palette-open]
    on the page, so triggers can sit wherever they make sense. */}
<dialog
  data-palette
  aria-label="Command palette"
  class="w-[min(38rem,calc(100vw-2rem))] border border-line-bright bg-surface p-0 text-ink backdrop:bg-void/70 backdrop:backdrop-blur-sm"
>
  <div class="flex items-center gap-3 border-b border-line px-4">
    <span aria-hidden="true" class="font-mono text-xs text-signal">&gt;</span>
    <input
      data-palette-input
      type="text"
      placeholder="Search work, metrics, papers…"
      autocomplete="off"
      spellcheck="false"
      class="w-full bg-transparent py-4 font-mono text-sm text-ink outline-none placeholder:text-ink-dim"
    />
    <kbd
      class="shrink-0 border border-line px-1.5 py-0.5 font-mono text-[10px] text-ink-dim"
      >ESC</kbd
    >
  </div>

  <ul
    data-palette-list
    role="listbox"
    class="max-h-[min(24rem,60vh)] overflow-y-auto py-2"
  >
    {
      items.map((item, i) => (
        <li
          role="option"
          data-palette-item
          data-index={i}
          data-label={item.label.toLowerCase()}
          data-keywords={`${item.label} ${item.hint} ${item.keywords}`.toLowerCase()}
          data-href={item.href}
          data-group={item.group}
          class="group mx-2 flex cursor-pointer items-baseline justify-between gap-4 px-3 py-2.5 aria-selected:bg-raised"
        >
          <span class="min-w-0">
            <span class="block truncate text-sm text-ink group-aria-selected:text-signal">
              {item.label}
            </span>
            <span class="mt-0.5 block truncate text-xs text-ink-dim">
              {item.hint}
            </span>
          </span>
          <span class="label shrink-0 group-aria-selected:text-signal">
            {item.group}
          </span>
        </li>
      ))
    }
    <li data-palette-empty class="hidden px-5 py-8 text-center">
      <span class="font-mono text-sm text-ink-dim">No matches</span>
    </li>
  </ul>

  <div
    class="flex items-center justify-between border-t border-line px-4 py-2.5 font-mono text-[10px] text-ink-dim"
  >
    <span>↑↓ navigate · ↵ open · esc close</span>
    <span data-palette-count></span>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-palette]");
  const input = document.querySelector<HTMLInputElement>(
    "[data-palette-input]",
  );
  const list = document.querySelector<HTMLElement>("[data-palette-list]");
  const empty = document.querySelector<HTMLElement>("[data-palette-empty]");
  const count = document.querySelector<HTMLElement>("[data-palette-count]");

  if (dialog && input && list && empty && count) {
    const items = Array.from(
      list.querySelectorAll<HTMLElement>("[data-palette-item]"),
    );
    let visible = items;
    let active = 0;

    const paint = () => {
      items.forEach((el) => el.setAttribute("aria-selected", "false"));
      const current = visible[active];
      if (current) {
        current.setAttribute("aria-selected", "true");
        current.scrollIntoView({ block: "nearest" });
      }
      count.textContent = `${visible.length} result${visible.length === 1 ? "" : "s"}`;
    };

    /**
     * Subsequence match, scored — "ttd" should find "Talk to Data".
     *
     * Filtering alone is not enough: those three letters appear in almost
     * every string, so a bare subsequence test returns nearly the whole list.
     * What makes a palette feel sharp is *ranking* — initials and prefixes
     * beat substrings, substrings beat scattered matches, and tightly-grouped
     * matches beat ones spread across the string.
     *
     * Returns -1 for no match, higher is better.
     */
    const score = (label: string, keywords: string, q: string) => {
      if (!q) return 0;

      // Initials: "ttd" -> "Talk to Data".
      const initials = label
        .split(/[\s\-/]+/)
        .map((w) => w[0] ?? "")
        .join("");
      if (initials.startsWith(q)) return 1000;

      if (label.startsWith(q)) return 900;
      if (label.includes(q)) return 800 - label.indexOf(q);
      if (keywords.includes(q)) return 500 - keywords.indexOf(q);

      // Scattered subsequence, penalised by how far apart the hits are.
      let i = 0;
      let first = -1;
      let last = -1;
      for (let p = 0; p < label.length && i < q.length; p++) {
        if (label[p] === q[i]) {
          if (first === -1) first = p;
          last = p;
          i++;
        }
      }
      if (i === q.length) return 300 - (last - first);

      return -1;
    };

    const filter = () => {
      const q = input.value.trim().toLowerCase();

      const scored = items
        .map((el) => ({
          el,
          s: score(el.dataset.label ?? "", el.dataset.keywords ?? "", q),
        }))
        .filter((r) => r.s >= 0)
        .sort((a, b) => b.s - a.s);

      const hits = new Set(scored.map((r) => r.el));
      items.forEach((el) => el.classList.toggle("hidden", !hits.has(el)));

      // Reorder the DOM so the best match is genuinely first, not just
      // highlighted first.
      if (q) scored.forEach((r) => list.appendChild(r.el));
      else items.forEach((el) => list.appendChild(el));
      list.appendChild(empty);

      visible = scored.map((r) => r.el);
      empty.classList.toggle("hidden", visible.length > 0);
      active = 0;
      paint();
    };

    const open = () => {
      if (dialog.open) return;
      dialog.showModal();
      input.value = "";
      filter();
      input.focus();
    };

    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        dialog.open ? dialog.close() : open();
        return;
      }
      // Bare "/" opens too, as long as the user isn't already typing.
      const target = e.target as HTMLElement | null;
      const typing =
        target instanceof HTMLInputElement ||
        target instanceof HTMLTextAreaElement;
      if (e.key === "/" && !dialog.open && !typing) {
        e.preventDefault();
        open();
      }
    });

    document
      .querySelectorAll<HTMLElement>("[data-palette-open]")
      .forEach((btn) => btn.addEventListener("click", open));

    input.addEventListener("input", filter);

    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        if (!visible.length) return;
        active =
          (active + (e.key === "ArrowDown" ? 1 : -1) + visible.length) %
          visible.length;
        paint();
      } else if (e.key === "Enter") {
        e.preventDefault();
        const href = visible[active]?.dataset.href;
        if (href) window.location.href = href;
      }
    });

    items.forEach((el) => {
      el.addEventListener("click", () => {
        const href = el.dataset.href;
        if (href) window.location.href = href;
      });
      el.addEventListener("mousemove", () => {
        const i = visible.indexOf(el);
        if (i !== -1 && i !== active) {
          active = i;
          paint();
        }
      });
    });

    // Clicking the backdrop closes; clicking the panel does not.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>

<style>
  dialog[data-palette] {
    margin: 12vh auto auto;
  }

  dialog[data-palette]::backdrop {
    animation: fade-backdrop 160ms ease both;
  }

  dialog[data-palette][open] {
    animation: pop-in 180ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* Both keyframes declare an explicit `to`. With `animation-fill-mode: both`
     the forwards fill holds the *last* keyframe — so a `from`-only rule pins
     the element back at opacity 0 once it finishes, and the dialog opens
     invisibly. */
  @keyframes fade-backdrop {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes pop-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    dialog[data-palette][open],
    dialog[data-palette]::backdrop {
      animation: none;
    }
  }
</style>
