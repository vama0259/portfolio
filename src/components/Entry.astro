---
/**
 * A work-index row, not a card. Replaces WorkCard.astro. Full-width, three
 * lines: title (Spectral 600), tagline (Spectral, muted), a metadata line
 * (period, status, up to four stack items separated by a hairline pipe).
 * The whole row is the link target. Minimum tap height 56px.
 */
interface Props {
  slug: string;
  title: string;
  tagline: string;
  status: "production" | "research" | "shipped";
  period: string;
  stack: readonly string[];
  /** Position in the list; staggers the scroll-reveal, capped at 6 rows. */
  revealIndex?: number;
}

const { slug, title, tagline, status, period, stack, revealIndex } = Astro.props;
const meta = [period, status, ...stack.slice(0, 4)];
const delay = revealIndex !== undefined ? Math.min(revealIndex, 5) * 60 : 0;
---

<a
  href={`/work/${slug}`}
  class="entry-link entry-row"
  data-reveal="entry"
  style={`transition-delay: ${delay}ms`}
>
  <h3 class="entry-title">
    {title}
    {status === "production" && (
      <span aria-label="In production" class="status-mark"> ●</span>
    )}
  </h3>
  <p class="entry-tagline">
    {tagline}
  </p>
  <p class="u-label entry-meta">
    {meta.join(" ❘ ")}
  </p>
</a>

<style>
  .entry-link:hover h3,
  .entry-link:focus-visible h3 {
    color: var(--color-accent);
  }
  .entry-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
</style>
