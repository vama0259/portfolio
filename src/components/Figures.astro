---
/**
 * The results table. Replaces MetricStrip.astro. A <dl>-derived structure:
 * each row is value + label + a marker anchoring to its basis note. Value
 * uses `.fig`. Rows separated by one --color-hairline. The marker is a real
 * in-page anchor to a <BasisNote> in the rail, so the apparatus works with
 * JS disabled.
 */
interface Metric {
  label: string;
  value: string;
  basis: string;
}

interface Props {
  metrics: readonly Metric[];
  /** Unique per instance so ids never collide across a page. */
  prefix: string;
}

const { metrics, prefix } = Astro.props;
const letters = "abcdefghij";
---

<Fragment>
  <dl
    class="breakout"
    style="margin-top: var(--space-block); display: grid; grid-template-columns: auto 1fr auto; column-gap: 1rem; row-gap: 0;"
  >
    {
      metrics.map((m, i) => {
        const marker = letters[i] ?? String(i + 1);
        const id = `basis-${prefix}-${marker}`;
        return (
          <div
            class="figures-row"
            style={`display: contents;`}
          >
            <dt
              class="fig"
              style="grid-column: 1; font-size: var(--text-figure); line-height: var(--text-figure--line-height); text-align: right; align-self: center; padding-block: var(--space-tight); border-top: 1px solid var(--color-hairline);"
            >
              {m.value}
            </dt>
            <dd
              style="grid-column: 2; align-self: center; padding-block: var(--space-tight); padding-inline-start: var(--space-para); font-size: var(--text-body); color: var(--color-ink); border-top: 1px solid var(--color-hairline);"
            >
              {m.label}
            </dd>
            <dd
              style="grid-column: 3; align-self: center; padding-block: var(--space-tight); border-top: 1px solid var(--color-hairline);"
            >
              <a
                href={`#${id}`}
                class="fig basis-marker"
                aria-label={`Basis for ${m.label}`}
                style="font-size: 0.6875rem; color: var(--color-accent); vertical-align: super; text-decoration: none;"
              >
                [{marker}]
              </a>
            </dd>
          </div>
        );
      })
    }
  </dl>

  <ul class="rail basis-list" style="padding: 0; margin-top: var(--space-tight);">
    {
      metrics.map((m, i) => {
        const marker = letters[i] ?? String(i + 1);
        const id = `basis-${prefix}-${marker}`;
        return (
          <li
            id={id}
            style="font-style: italic; font-size: var(--text-note); line-height: var(--text-note--line-height); color: var(--color-ink-muted); list-style: none; padding-left: var(--space-note); border-left: 2px solid var(--color-rule); margin-block: var(--space-tight);"
          >
            <span class="fig" style="color: var(--color-accent); margin-right: 0.35em;">
              [{marker}]
            </span>
            {m.basis}
          </li>
        );
      })
    }
  </ul>
</Fragment>
