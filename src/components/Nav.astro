---
/**
 * One line, <=64px tall. Four items: Work, Research, About, email. Sentence
 * case, not uppercase-tracked. Current page marked with a 2px accent
 * underline. No logo mark, no status dot, no locale strip, no theme toggle.
 */
import { profile } from "../data/profile";

interface Props {
  sticky?: boolean;
}
const { sticky = false } = Astro.props;

const path = Astro.url.pathname;
const links = [
  { href: "/work", label: "Work" },
  { href: "/research", label: "Research" },
  { href: "/about", label: "About" },
];

const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header
  class:list={["nav-bar", sticky && "nav-bar--sticky"]}
>
  <nav
    aria-label="Primary"
    class="sheet nav-inner"
  >
    <div class="nav-row">
      <a href="/" class="u-label nav-brand">
        {profile.name}
      </a>

      <ul class="nav-list">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class="u-label nav-link"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={`mailto:${profile.email}`}
            class="u-label nav-email"
          >
            {profile.email}
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<style>
  .nav-bar--sticky {
    position: sticky;
    top: 0;
    z-index: 40;
  }
</style>
