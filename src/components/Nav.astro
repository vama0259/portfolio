---
/**
 * Sticky technical header — brand + mono nav links with a draw-in underline
 * on hover/active, email on the right. Matches mockups/c-technical.html.
 */
import { profile } from "../data/profile";

interface Props {
  sticky?: boolean;
}
const { sticky = true } = Astro.props;

const path = Astro.url.pathname;
const links = [
  { href: "/work", label: "Work" },
  { href: "/research", label: "Research" },
  { href: "/about", label: "About" },
];

const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class:list={["nav-bar", sticky && "nav-bar--sticky"]}>
  <div class="nav-inner">
    <a href="/" class="display nav-brand">{profile.name}</a>
    <nav aria-label="Primary">
      <ul class="nav-list nav-list--links">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class="nav-link"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={`mailto:${profile.email}`} class="nav-email">{profile.email}</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
