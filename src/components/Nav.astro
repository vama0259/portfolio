---
/**
 * One line, <=64px tall. Four items: Work, Research, About, email. Sentence
 * case, not uppercase-tracked. Current page marked with a 2px accent
 * underline. No logo mark, no status dot, no locale strip, no theme toggle.
 */
import { profile } from "../data/profile";

interface Props {
  sticky?: boolean;
}
const { sticky = false } = Astro.props;

const path = Astro.url.pathname;
const links = [
  { href: "/work", label: "Work" },
  { href: "/research", label: "Research" },
  { href: "/about", label: "About" },
];

const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header
  class:list={["nav-bar", sticky && "nav-bar--sticky"]}
  style={`border-bottom: 1px solid var(--color-rule); background-color: var(--color-paper);`}
>
  <nav
    aria-label="Primary"
    class="sheet"
    style="grid-template-rows: auto; align-items: center; padding-block: 0.75rem;"
  >
    <div style="grid-column: full; display: flex; align-items: center; justify-content: space-between; gap: 1rem; max-width: var(--page-max); margin-inline: auto;">
      <a href="/" class="u-label" style="font-size: var(--text-caption); color: var(--color-ink);">
        {profile.name}
      </a>

      <ul style="display: flex; align-items: center; gap: 1.25rem; list-style: none;">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class="u-label nav-link"
                style={`font-size: var(--text-caption); color: ${isActive(link.href) ? "var(--color-ink)" : "var(--color-ink-muted)"}; border-bottom: 2px solid ${isActive(link.href) ? "var(--color-accent)" : "transparent"}; padding-bottom: 2px;`}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={`mailto:${profile.email}`}
            class="u-label"
            style="font-size: var(--text-caption); color: var(--color-ink-muted);"
          >
            {profile.email}
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<style>
  .nav-bar--sticky {
    position: sticky;
    top: 0;
    z-index: 40;
  }
</style>
