---
// Weight 500 is not requested anywhere: grepped `font-weight:\s*500` and
// Tailwind `font-medium` across src/ — zero matches for both Space Grotesk
// and Source Sans 3. Those two imports were dead weight; dropped. 400/600/700
// are all reachable (400 implicit body text, 600/700 via display/heading
// classes in global.css), so they stay.
//
// Latin-only subset paths: the umbrella per-weight files (e.g. `400.css`)
// bundle 7 @font-face blocks per weight (cyrillic/cyrillic-ext/greek/
// greek-ext/vietnamese/latin-ext/latin) for Source Sans 3, 3 per weight for
// Space Grotesk. Verified via `node -e "fs.readdirSync(...)"` against the
// installed package that `latin-*.css` files exist for every weight used
// here, each carrying exactly 1 @font-face. Confirmed against
// @fontsource/source-sans-3/unicode.json that the "latin" range
// (U+0000-00FF, U+2000-206F, U+2191, U+2193, ...) covers every glyph this
// site actually prints in these families — en/em dash, the "·" separator,
// and "↓" (used via CSS content) are all in range. The one exception is the
// "→" in web-agent.md's raw metric value ("30% → 59–68%"), which sits
// outside the latin unicode-range; browsers fall back to the next font in
// the --font-mono/--font-sans stack for that single glyph automatically, so
// nothing renders as tofu — just that one character borrows a fallback
// font. JetBrains Mono Variable has no latin-only variable build (only
// `wght.css`/`wght-italic.css`, each still shipping cyrillic/greek/
// vietnamese/latin-ext @font-face blocks alongside latin), so it is left
// as-is rather than swapped to a non-variable package, which would be a
// bigger change than subsetting.
import "@fontsource/space-grotesk/latin-400.css";
import "@fontsource/space-grotesk/latin-600.css";
import "@fontsource/space-grotesk/latin-700.css";
import "@fontsource/source-sans-3/latin-400.css";
import "@fontsource/source-sans-3/latin-400-italic.css";
import "@fontsource/source-sans-3/latin-600.css";
import "@fontsource/source-sans-3/latin-700.css";
import "@fontsource-variable/jetbrains-mono";
// Preload only the two faces that paint above the fold — the display 700 that
// draws every <h1> and the body 400. Vite rewrites these to the hashed asset
// URLs it emits, so the <link rel="preload"> can never drift from the file the
// @font-face rule above actually requests. Preloading more than the LCP faces
// costs bandwidth against the thing you are trying to speed up.
import displayFont from "@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2?url";
import bodyFont from "@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2?url";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Colophon from "../components/Colophon.astro";
import { profile } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
  navSticky?: boolean;
  /** `article` on case studies, `profile` on /about — anything else is a page. */
  ogType?: "website" | "article" | "profile";
  /** Page-specific JSON-LD nodes, merged into the site-wide @graph. */
  schemas?: Record<string, unknown>[];
  /** Visible trail, also emitted as BreadcrumbList. Home is prepended. */
  breadcrumbs?: { name: string; path: string }[];
  /** Keeps utility pages (404) out of the index without blocking the crawl. */
  noindex?: boolean;
}

const {
  // profile.title in full ("Data Scientist · Generative AI & LLM Engineer")
  // pushes the home <title> to 62 characters and Google truncates it. The
  // shortened form keeps the name first and the two terms someone would
  // actually search for.
  title = `${profile.name} — Generative AI & LLM Engineer`,
  // profile.positioning is the on-page promise, not a meta description: at ~190
  // characters Google truncates it mid-clause. Meta descriptions are written to
  // fit 150-160 and every page passes its own; this is the fallback.
  description = "Data scientist at Michelin building production LLM systems: agent architectures, the evaluation stacks that prove they work, and the guardrails that hold.",
  navSticky = false,
  ogType = "website",
  schemas = [],
  breadcrumbs,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://example.com");
// PNG is primary: SVG og:image support is inconsistent on X/LinkedIn crawlers.
// SVG stays as a secondary og:image entry (multiple og:image tags are valid OG).
const ogImagePng = new URL("/og-image.png", Astro.site ?? "https://example.com");
const ogImageSvg = new URL("/og-image.svg", Astro.site ?? "https://example.com");
const ogImageAlt = `${profile.name} — ${profile.title}: 50+ analysts served, 95% accuracy, 27 hrs/week saved`;

const siteUrl = (Astro.site ?? "https://example.com").toString();

// One @graph per page rather than a stack of loose <script> blocks: the nodes
// cross-reference each other by @id (an Article's author points at the same
// Person node the home page declares), which is what lets a parser build one
// entity instead of three unrelated ones.
const personId = `${siteUrl}#person`;
const siteId = `${siteUrl}#website`;

const personLd = {
  "@type": "Person",
  "@id": personId,
  name: profile.name,
  jobTitle: profile.title,
  description: profile.positioning,
  email: `mailto:${profile.email}`,
  image: ogImagePng.toString(),
  worksFor: {
    "@type": "Organization",
    name: profile.roles[0].company,
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Pune",
    addressCountry: "IN",
  },
  knowsAbout: profile.skills.flatMap((g) => g.items as readonly string[]),
  url: siteUrl,
  sameAs: [profile.linkedin, profile.github],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: profile.education.school,
  },
};

const websiteLd = {
  "@type": "WebSite",
  "@id": siteId,
  url: siteUrl,
  name: `${profile.name} — ${profile.title}`,
  inLanguage: "en",
  publisher: { "@id": personId },
};

const trail = breadcrumbs ? [{ name: "Home", path: "/" }, ...breadcrumbs] : null;
const breadcrumbLd = trail && {
  "@type": "BreadcrumbList",
  itemListElement: trail.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    item: new URL(c.path, siteUrl).toString(),
  })),
};

const graph = {
  "@context": "https://schema.org",
  "@graph": [personLd, websiteLd, ...(breadcrumbLd ? [breadcrumbLd] : []), ...schemas],
};
---

<!doctype html>
<html lang="en">
  <head>
    <script>document.documentElement.classList.add("js-anim");</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={profile.name} />
    {
      /* The defaults are index,follow — but not the snippet and image limits.
         Without max-image-preview:large a result carries a thumbnail instead of
         a full-width image, and max-snippet:-1 lets Google quote as much of the
         page as it judges useful rather than capping it. */
    }
    <meta
      name="robots"
      content={noindex
        ? "noindex, follow"
        : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#EEF0EC" />
    <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {
      /* og:type=profile has its own required-ish properties; without them the
         type is declared and then unfulfilled. */
      ogType === "profile" && (
        <>
          <meta property="profile:first_name" content={profile.name.split(" ")[0]} />
          <meta property="profile:last_name" content={profile.name.split(" ").slice(1).join(" ")} />
          <meta property="profile:username" content="vama0259" />
        </>
      )
    }
    <meta property="og:image" content={ogImagePng} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image" content={ogImageSvg} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImagePng} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    {/*
      Notes for maintainers live in CLAUDE.md and .design/, never in an HTML comment.
      An HTML comment ships to every visitor and shows up in View Source; an Astro
      comment like this one is compiled away. Do not describe the design, the intended
      reader, or the build process in markup.
    */}
    <div class="grid-bg" aria-hidden="true"></div>

    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 skip-link">
      Skip to content
    </a>

    <div class="page-shell">
      <Nav sticky={navSticky} />
      <main id="main" class="main-content">
        <slot />
      </main>
      <Colophon />
    </div>

    <script>
      import { initMotion } from "../scripts/motion";
      initMotion();
    </script>
  </body>
</html>
