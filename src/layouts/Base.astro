---
// Weight 500 is not requested anywhere: grepped `font-weight:\s*500` and
// Tailwind `font-medium` across src/ — zero matches for both Space Grotesk
// and Source Sans 3. Those two imports were dead weight; dropped. 400/600/700
// are all reachable (400 implicit body text, 600/700 via display/heading
// classes in global.css), so they stay.
import "@fontsource/space-grotesk/400.css";
import "@fontsource/space-grotesk/600.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/source-sans-3/400.css";
import "@fontsource/source-sans-3/400-italic.css";
import "@fontsource/source-sans-3/600.css";
import "@fontsource/source-sans-3/700.css";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Colophon from "../components/Colophon.astro";
import { profile } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
  navSticky?: boolean;
}

const {
  title = `${profile.name} - ${profile.title}`,
  description = profile.positioning,
  navSticky = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://example.com");
const ogImage = new URL("/og-image.svg", Astro.site ?? "https://example.com");
const ogImageAlt = `${profile.name} — ${profile.title}: 50+ analysts served, 95% accuracy, 27 hrs/week saved`;

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.title,
  worksFor: {
    "@type": "Organization",
    name: profile.roles[0].company,
  },
  url: (Astro.site ?? "https://example.com").toString(),
  sameAs: [profile.linkedin, profile.github],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: profile.education.school,
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <script>document.documentElement.classList.add("js-anim");</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#EEF0EC" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>
  <body>
    <!--
    THESIS: Swiss technical — a light ledger-paper offprint that reads as engineering
      documentation, not a landing page. It refuses the dark instrument-panel with one
      neon accent.
    OWN-WORLD: Light ledger paper #EEF0EC, near-black ink, one signal blue #2453D9
      rationed to links/active state/bars/critical flags, proof-correction red reserved
      for the guardrail rejection. Space Grotesk display, Source Sans 3 body,
      JetBrains Mono for data and labels. Zero radius. A 64px technical grid sits behind
      everything.
    STORY: A hiring manager reads a positioning line, a live-figures panel, three
      plotted results with their bases printed under each chart, drives Fig. 1's ReAct
      loop and bounces a write off the guardrail, then opens a case study and finds the
      trade-off and the errata stated without being asked.
    FORM: content is driven entirely by src/data/profile.ts and src/content/work — the
      mockup's hardcoded copy is a skin, not a source of truth.
    -->
    <div class="grid-bg" aria-hidden="true"></div>

    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 skip-link">
      Skip to content
    </a>

    <div class="page-shell">
      <Nav sticky={navSticky} />
      <main id="main" class="main-content">
        <slot />
      </main>
      <Colophon />
    </div>

    <script>
      import { initMotion } from "../scripts/motion";
      initMotion();
    </script>
  </body>
</html>
