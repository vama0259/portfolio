---
// Weight 500 is not requested anywhere: grepped `font-weight:\s*500` and
// Tailwind `font-medium` across src/ — zero matches for both Space Grotesk
// and Source Sans 3. Those two imports were dead weight; dropped. 400/600/700
// are all reachable (400 implicit body text, 600/700 via display/heading
// classes in global.css), so they stay.
//
// Latin-only subset paths: the umbrella per-weight files (e.g. `400.css`)
// bundle 7 @font-face blocks per weight (cyrillic/cyrillic-ext/greek/
// greek-ext/vietnamese/latin-ext/latin) for Source Sans 3, 3 per weight for
// Space Grotesk. Verified via `node -e "fs.readdirSync(...)"` against the
// installed package that `latin-*.css` files exist for every weight used
// here, each carrying exactly 1 @font-face. Confirmed against
// @fontsource/source-sans-3/unicode.json that the "latin" range
// (U+0000-00FF, U+2000-206F, U+2191, U+2193, ...) covers every glyph this
// site actually prints in these families — en/em dash, the "·" separator,
// and "↓" (used via CSS content) are all in range. The one exception is the
// "→" in web-agent.md's raw metric value ("30% → 59–68%"), which sits
// outside the latin unicode-range; browsers fall back to the next font in
// the --font-mono/--font-sans stack for that single glyph automatically, so
// nothing renders as tofu — just that one character borrows a fallback
// font. JetBrains Mono Variable has no latin-only variable build (only
// `wght.css`/`wght-italic.css`, each still shipping cyrillic/greek/
// vietnamese/latin-ext @font-face blocks alongside latin), so it is left
// as-is rather than swapped to a non-variable package, which would be a
// bigger change than subsetting.
import "@fontsource/space-grotesk/latin-400.css";
import "@fontsource/space-grotesk/latin-600.css";
import "@fontsource/space-grotesk/latin-700.css";
import "@fontsource/source-sans-3/latin-400.css";
import "@fontsource/source-sans-3/latin-400-italic.css";
import "@fontsource/source-sans-3/latin-600.css";
import "@fontsource/source-sans-3/latin-700.css";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Colophon from "../components/Colophon.astro";
import { profile } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
  navSticky?: boolean;
}

const {
  title = `${profile.name} - ${profile.title}`,
  description = profile.positioning,
  navSticky = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://example.com");
// PNG is primary: SVG og:image support is inconsistent on X/LinkedIn crawlers.
// SVG stays as a secondary og:image entry (multiple og:image tags are valid OG).
const ogImagePng = new URL("/og-image.png", Astro.site ?? "https://example.com");
const ogImageSvg = new URL("/og-image.svg", Astro.site ?? "https://example.com");
const ogImageAlt = `${profile.name} — ${profile.title}: 50+ analysts served, 95% accuracy, 27 hrs/week saved`;

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.title,
  worksFor: {
    "@type": "Organization",
    name: profile.roles[0].company,
  },
  url: (Astro.site ?? "https://example.com").toString(),
  sameAs: [profile.linkedin, profile.github],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: profile.education.school,
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <script>document.documentElement.classList.add("js-anim");</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#EEF0EC" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImagePng} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image" content={ogImageSvg} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImagePng} />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>
  <body>
    <!--
    THESIS: Swiss technical — a light ledger-paper offprint that reads as engineering
      documentation, not a landing page. It refuses the dark instrument-panel with one
      neon accent.
    OWN-WORLD: Light ledger paper #EEF0EC, near-black ink, one signal blue #2453D9
      rationed to links/active state/bars/critical flags, proof-correction red reserved
      for the guardrail rejection. Space Grotesk display, Source Sans 3 body,
      JetBrains Mono for data and labels. Zero radius. A 64px technical grid sits behind
      everything.
    STORY: A hiring manager reads a positioning line, a live-figures panel, three
      plotted results with their bases printed under each chart, drives Fig. 1's ReAct
      loop and bounces a write off the guardrail, then opens a case study and finds the
      trade-off and the errata stated without being asked.
    FORM: content is driven entirely by src/data/profile.ts and src/content/work — the
      mockup's hardcoded copy is a skin, not a source of truth.
    -->
    <div class="grid-bg" aria-hidden="true"></div>

    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 skip-link">
      Skip to content
    </a>

    <div class="page-shell">
      <Nav sticky={navSticky} />
      <main id="main" class="main-content">
        <slot />
      </main>
      <Colophon />
    </div>

    <script>
      import { initMotion } from "../scripts/motion";
      initMotion();
    </script>
  </body>
</html>
