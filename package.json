  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pa11y-ci": "^4.1.1",
    "playwright": "^1.62.1",
    "start-server-and-test": "^3.0.12",
    "typescript": "^6.0.3"
