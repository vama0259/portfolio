# Cloudflare Pages header rules. Caching is the CWV lever here: hashed assets
# in /_astro/ can never change under a given URL, so they get the immutable
# year; HTML must stay revalidated or a deploy would not be visible.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=604800

/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
